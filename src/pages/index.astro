---
import { Image } from 'astro:assets';
import isotipo from '../assets/isotipo.png';
import marca from '../assets/marca.png';
import trazo from '../assets/logo/trazo.png';
import cuerpoNaranja from '../assets/logo/cuerpo-naranja.png';
import cuerpoVerde from '../assets/logo/cuerpo-verde.png';
import cabezaMagenta from '../assets/logo/cabeza-magenta.png';
import cabezaAzul from '../assets/logo/cabeza-azul.png';
import cabezaNaranja from '../assets/logo/cabeza-naranja.png';
import cabezaVerde from '../assets/logo/cabeza-verde.png';
import pelota from '../assets/logo/pelota.png';
import rayos from '../assets/logo/rayos.png';
import QRCode from 'qrcode';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const demoUrl = new URL(`${base}/demo/`, Astro.site).href;
const demoQr = await QRCode.toString(demoUrl, { type: 'svg', margin: 1, color: { dark: '#0b1530' } });

// Piezas del isotipo en el orden en que se pintan al hacer scroll.
// de/dur: tramo del recorrido (0 a 1) en que aparece cada una.
// Los barridos giran alrededor del centro del aro; los brotes crecen desde su propio centro.
const capas = [
	{ src: trazo, tipo: 'barrido-inverso', de: 0, dur: 0.42, estilo: '--desde: 108deg; --giro: 220deg' },
	{ src: cabezaMagenta, tipo: 'brote', de: 0.05, dur: 0.08, estilo: '--origen: 29% 35.8%' },
	{ src: cabezaAzul, tipo: 'brote', de: 0.19, dur: 0.08, estilo: '--origen: 34.8% 69.4%' },
	{ src: cuerpoNaranja, tipo: 'barrido', de: 0.38, dur: 0.2, estilo: '--desde: 265deg; --giro: 170deg' },
	{ src: cabezaNaranja, tipo: 'brote', de: 0.47, dur: 0.08, estilo: '--origen: 43.6% 12.6%' },
	{ src: cuerpoVerde, tipo: 'barrido', de: 0.56, dur: 0.18, estilo: '--desde: 5deg; --giro: 112deg' },
	{ src: cabezaVerde, tipo: 'brote', de: 0.67, dur: 0.08, estilo: '--origen: 85.5% 43.1%' },
	{ src: pelota, tipo: 'brote', de: 0.74, dur: 0.1, estilo: '--origen: 78.9% 62.7%' },
	{ src: rayos, tipo: 'brote', de: 0.84, dur: 0.14, estilo: '--origen: 66.8% 34.5%' },
];

// Datos de contacto: la sección solo se muestra cuando hay al menos uno.
// WhatsApp va con código de país y solo dígitos, por ejemplo '51987654321'.
const contacto = { whatsapp: '', correo: '' };
const saludo = 'Hola, quiero saber más sobre COLAB Cultural.';
const hayContacto = Boolean(contacto.whatsapp || contacto.correo);

// 38.8% de un aula de 45 son unos 17 estudiantes
const enRiesgo = new Set([1, 4, 7, 9, 12, 14, 17, 20, 22, 24, 27, 29, 32, 35, 38, 40, 43]);
const mateo = 22;

const etapas = [
	{ nombre: 'Diagnóstico', texto: 'Escuchamos a estudiantes, familias y docentes para entender su realidad.' },
	{
		nombre: 'Laboratorios',
		texto: 'Espacios de cine, deporte y muralismo donde los adolescentes crean y deciden.',
		labs: [
			{ nombre: 'Cine', texto: 'Los estudiantes graban el documental colaborativo “Nuestras historias”.' },
			{ nombre: 'Deporte', texto: 'El deporte como espacio de encuentro y trabajo en equipo.' },
			{
				nombre: 'Muralismo',
				texto: 'Pintan murales que luego se digitalizan y cobran vida con realidad aumentada.',
			},
		],
	},
	{ nombre: 'Festival', texto: 'La comunidad se reúne para ver, celebrar y hacer suyo lo creado.' },
];

const aliados = [
	{
		corto: 'I.E. 14144',
		nombre: 'I.E. 14144 Santa Rosa',
		tipo: 'Escuela',
		texto: 'El colegio donde trabajamos con 45 estudiantes.',
	},
	{
		corto: 'Fe y Alegría 48',
		nombre: 'Fe y Alegría 48',
		tipo: 'Escuela',
		texto: 'Institución educativa aliada del proyecto.',
	},
	{
		corto: 'APAFA',
		nombre: 'APAFA',
		tipo: 'Familias',
		texto: 'La asociación de padres de familia: reuniones quincenales con métricas de evaluación y retroalimentación sobre cine, deporte y muralismo.',
	},
	{
		corto: 'Municipalidad',
		nombre: 'Municipalidad de Tambogrande',
		tipo: 'Estado',
		texto: 'El gobierno local del distrito.',
	},
	{
		corto: 'UGEL',
		nombre: 'UGEL',
		tipo: 'Estado',
		texto: 'La Unidad de Gestión Educativa Local, autoridad educativa de la zona.',
	},
	{
		corto: 'Cumbeque',
		nombre: 'Cumbeque Producciones',
		tipo: 'Colectivo cultural',
		texto: 'Colectivo cultural de Piura.',
	},
	{
		corto: 'Club de Arte',
		nombre: 'Club de Arte y Cultura',
		tipo: 'Colectivo cultural',
		texto: 'Colectivo cultural de Piura.',
	},
	{
		corto: 'Dijkstraidos',
		nombre: 'Dijkstraidos',
		tipo: 'Tecnología',
		texto: 'Aliado de innovación: con ellos desarrollamos los murales con realidad aumentada.',
	},
].map((aliado, i, lista) => {
	// Cada aliado ocupa un punto del círculo alrededor de COLAB
	const angulo = (i / lista.length) * 2 * Math.PI - Math.PI / 2;
	return { ...aliado, x: Math.cos(angulo), y: Math.sin(angulo) };
});

const sostenibilidad = [
	{
		titulo: 'Núcleo juvenil',
		texto: 'Líderes estudiantiles que seguirán organizando actividades culturales, acompañados por una red de docentes, artistas, organizaciones y emprendimientos.',
	},
	{
		titulo: 'APAFA, compromiso constante',
		texto: 'Reuniones quincenales con mapeo de padres de familia y métricas de evaluación sobre cine, deporte y muralismo.',
	},
	{
		titulo: 'Comité de soporte',
		texto: 'Padres de familia, psicólogo(a), estudiantes y especialistas: personas de confianza para prevenir y reforzar lo aprendido.',
	},
];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="COLAB Cultural: arte y cultura para prevenir el consumo de alcohol y tabaco en adolescentes de Tambogrande, Piura."
		/>
		<title>COLAB Cultural — El arte y la cultura transforman</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bree+Serif&family=Nunito:wght@400;600;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="barra">
			<a class="marca" href="#inicio">
				<Image src={isotipo} alt="" width={44} height={44} />
				<span>COLAB <small>Cultural</small></span>
			</a>
			<nav aria-label="Secciones">
				<a href="#mateo">Mateo</a>
				<a href="#impacto">Impacto</a>
				<a href="#proceso">Proceso</a>
				<a href="#innovacion">Innovación</a>
				<a href="#aliados">Aliados</a>
				{hayContacto && <a href="#contacto">Contacto</a>}
			</nav>
			<i class="avance" aria-hidden="true"></i>
		</header>

		<main>
			<section id="inicio" class="escena">
				<div class="hero">
					<div>
						<p class="etiqueta">Tambogrande, Piura</p>
						<h1>Elegir también es una <em>oportunidad</em></h1>
						<p class="bajada">
							Usamos el arte y la cultura para que los adolescentes encuentren nuevas formas de participar.
						</p>
						<a class="boton" href="#mateo">Conoce la historia de Mateo</a>
						<p class="pista-scroll" aria-hidden="true">Desliza y mira cómo se pinta el logo ↓</p>
					</div>
					<div
						class="hero-logo"
						role="img"
						aria-label="COLAB Cultural. El arte y la cultura transforman. La comunidad nos une."
					>
						<div class="iso gira">
							<Image class="boceto" src={isotipo} alt="" width={640} height={640} loading="eager" />
							{
								capas.map((capa) => (
									<Image
										class:list={['capa', capa.tipo]}
										style={`--de: ${capa.de}; --dur: ${capa.dur}; ${capa.estilo}`}
										src={capa.src}
										alt=""
										width={640}
										height={640}
										loading="eager"
									/>
								))
							}
						</div>
						<Image src={marca} alt="" width={420} height={197} loading="eager" />
					</div>
				</div>
			</section>

			<section id="mateo" class="historia" data-paso="1">
				<div class="historia-visual">
					<div class="aula" aria-hidden="true">
						{
							Array.from({ length: 45 }, (_, i) => (
								<span class:list={['alumno', { riesgo: enRiesgo.has(i), mateo: i === mateo }]}>
									<svg viewBox="0 0 24 32">
										<circle cx="12" cy="7" r="6" />
										<path d="M2 32c0-9 4-15 10-15s10 6 10 15z" />
									</svg>
								</span>
							))
						}
					</div>
					<p class="aula-pie">Un aula de 45 estudiantes, como el grupo con el que trabajamos.</p>
				</div>
				<div class="historia-pasos">
					<article class="paso" data-paso="1">
						<p class="dato"><span data-contar="38.8" data-decimales="1">38.8</span>%</p>
						<p>
							de escolares de secundaria en Perú ha consumido alcohol o tabaco alguna vez.
							<cite>DEVIDA, 2024</cite>
						</p>
						<p>En un aula de 45, eso equivale a unos 17 estudiantes.</p>
					</article>
					<article class="paso" data-paso="2">
						<h2>Uno de ellos podría ser Mateo</h2>
						<p>Mateo podría ser el protagonista de su propia historia y no una cifra más.</p>
					</article>
					<article class="paso" data-paso="3">
						<h2>¿Qué historia le toca a Mateo?</h2>
						<div class="eleccion" role="group" aria-label="Elige el camino de Mateo">
							<button type="button" data-eleccion="cifra" aria-pressed="false">Una cifra más</button>
							<button type="button" data-eleccion="protagonista" aria-pressed="false">
								Protagonista de su historia
							</button>
						</div>
						<div aria-live="polite">
							<p data-resultado="cifra" hidden>
								Sin otra opción, Mateo se pierde en la estadística. Prueba el otro camino.
							</p>
							<p data-resultado="protagonista" hidden>
								Elegir también es una oportunidad: con arte y cultura, Mateo y su aula encuentran nuevas
								formas de participar. <a href="#impacto">Mira el cambio que buscamos</a>
							</p>
						</div>
					</article>
				</div>
			</section>

			<section id="impacto" class="impacto">
				<div class="contenedor">
					<h2>Impacto social</h2>
					<blockquote>
						“No queremos solo realizar actividades. Queremos generar nuevas oportunidades de participación”.
					</blockquote>
					<ul class="metas">
						<li>
							<strong><span data-contar="45">45</span></strong>
							<span>estudiantes de la I.E. 14144 Santa Rosa</span>
						</li>
						<li>
							<strong><span data-contar="80">80</span>% ↑</strong>
							<span>habilidades de prevención</span>
							<div class="medidor" style="--valor: 80%"><i></i></div>
						</li>
						<li>
							<strong><span data-contar="70">70</span>% ↑</strong>
							<span>participación comunitaria</span>
							<div class="medidor" style="--valor: 70%"><i></i></div>
						</li>
					</ul>
				</div>
			</section>

			<section id="proceso" class="contenedor">
				<h2>Un proceso en 3 etapas</h2>
				<div class="proceso" style="--activa: 0">
					<div class="linea" role="tablist" aria-label="Etapas del proceso">
						{
							etapas.map((etapa, i) => (
								<button
									type="button"
									role="tab"
									id={`etapa-${i}`}
									aria-controls={`panel-${i}`}
									aria-selected={i === 0 ? 'true' : 'false'}
									tabindex={i === 0 ? 0 : -1}
								>
									<span class="numero">{i + 1}</span>
									{etapa.nombre}
								</button>
							))
						}
					</div>
					{
						etapas.map((etapa, i) => (
							<div class="panel" role="tabpanel" id={`panel-${i}`} aria-labelledby={`etapa-${i}`} hidden={i !== 0}>
								<h3>{etapa.nombre}</h3>
								<p>{etapa.texto}</p>
								{etapa.labs && (
									<ul class="labs">
										{etapa.labs.map((lab) => (
											<li>
												<strong>{lab.nombre}</strong>
												{lab.texto}
											</li>
										))}
									</ul>
								)}
								{i < etapas.length - 1 && (
									<button type="button" class="siguiente" data-ir={i + 1}>
										Siguiente: {etapas[i + 1].nombre} →
									</button>
								)}
							</div>
						))
					}
				</div>
			</section>

			<section id="innovacion" class="innovacion">
				<div class="contenedor">
					<p class="etiqueta">Innovación</p>
					<h2>Murales con realidad aumentada</h2>
					<p class="bajada">
						Los estudiantes pintan el mural y lo digitalizan. Después, cualquier persona puede escanearlo con
						la app y descubrir lo que guarda. Lo desarrollamos junto a nuestro aliado <strong>Dijkstraidos</strong>.
					</p>

					<ol class="pasos">
						<li><span>1</span> Pinta y digitaliza</li>
						<li><span>2</span> Escanea con la app</li>
					</ol>

					<div class="opciones">
						<article>
							<div class="demo demo-ar" aria-hidden="true">
								<div class="mural"></div>
								<div class="telefono">
									<div class="pantalla">
										<i></i><i></i><i></i>
										<b>Cuídate y cuida a tu comunidad</b>
									</div>
								</div>
							</div>
							<p class="opcion">Opción 1</p>
							<h3>Murales interactivos</h3>
							<p>Al apuntar la cámara, el mural se anima o muestra mensajes de prevención.</p>
						</article>
						<article>
							<div class="demo demo-video" aria-hidden="true">
								<div class="mural"></div>
								<div class="telefono">
									<div class="pantalla">
										<u></u>
										<b>Documental colaborativo</b>
									</div>
								</div>
							</div>
							<p class="opcion">Opción 2</p>
							<h3>Cruce de laboratorios</h3>
							<p>
								El mural funciona como marcador para reproducir fragmentos del documental que graban los
								chicos.
							</p>
						</article>
					</div>

					<div class="prueba">
						<div class="prueba-texto">
							<p class="etiqueta">Demo</p>
							<h3>Pruébalo ahora</h3>
							<ol>
								<li>Escanea el código QR con tu celular.</li>
								<li>Abre la cámara y apunta al mural.</li>
								<li>Cambia entre el mural interactivo y el documental.</li>
							</ol>
							<div class="qr" set:html={demoQr} role="img" aria-label="Código QR de la demo" />
							<a class="boton" href={`${base}/demo/`}>Abrir la demo en este dispositivo</a>
							<p class="aviso">Mural y video de prueba, hasta tener los que creen los estudiantes.</p>
						</div>
						<div class="mural-vivo">
							<button type="button" class="mural-boton" aria-pressed="false">
								<img
									src={`${base}/demo/mural.png`}
									alt="Mural de prueba: jóvenes tomados de la mano frente a cerros, un río, un árbol de mango, una pelota y una claqueta de cine. Tócalo para simular el escaneo."
									width="1200"
									height="900"
									loading="lazy"
								/>
								<span class="capa-ar" aria-hidden="true">
									<i class="escaner"></i>
									<i class="sol-aro"></i>
									<i class="sol"></i>
									<i class="pelota"></i>
									<i class="mango" style="left: 17.9%; top: 43.9%"></i>
									<i class="mango" style="left: 27.9%; top: 43.9%; animation-delay: -0.25s"></i>
									<i class="mango" style="left: 21.3%; top: 50.6%; animation-delay: -0.5s"></i>
									<i class="mango" style="left: 23.3%; top: 37.8%; animation-delay: -0.4s"></i>
									<i class="mango" style="left: 30.8%; top: 51.1%; animation-delay: -0.1s"></i>
									<b class="cartel">Cuídate y cuida a tu comunidad</b>
								</span>
							</button>
							<p class="mural-pista">Sin celular a la mano: toca el mural para ver lo que mostraría la cámara.</p>
						</div>
					</div>
				</div>
			</section>

			<section id="aliados" class="contenedor">
				<h2>Aliados clave</h2>
				<p class="bajada">Una red alrededor de los estudiantes. Toca cada aliado para ver su papel.</p>
				<div class="red">
					<div class="mapa">
						<svg viewBox="-100 -100 200 200" aria-hidden="true">
							{aliados.map((a, i) => <line x1="0" y1="0" x2={a.x * 78} y2={a.y * 78} data-linea={i} class:list={{ activa: i === 0 }} />)}
						</svg>
						<Image class="centro" src={isotipo} alt="COLAB Cultural" width={140} height={140} />
						{
							aliados.map((a, i) => (
								<button
									type="button"
									class="nodo"
									data-aliado={i}
									data-tipo={a.tipo}
									aria-pressed={i === 0 ? 'true' : 'false'}
									style={`left: ${50 + a.x * 39}%; top: ${50 + a.y * 39}%`}
								>
									{a.corto}
								</button>
							))
						}
					</div>
					<div class="ficha" aria-live="polite">
						{
							aliados.map((a, i) => (
								<article data-ficha={i} hidden={i !== 0}>
									<p class="etiqueta">{a.tipo}</p>
									<h3>{a.nombre}</h3>
									<p>{a.texto}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section id="sostenibilidad" class="contenedor">
				<h2>Sostenibilidad y durabilidad</h2>
				<div class="tarjetas">
					{
						sostenibilidad.map((item) => (
							<article>
								<h3>{item.titulo}</h3>
								<p>{item.texto}</p>
							</article>
						))
					}
				</div>
				<p class="nota">
					Institucionalización como Asociación Civil y alianzas de ingresos: RSE, gobierno y fondos
					concursables.
				</p>
			</section>

			<section class="cierre">
				<p>El futuro de los adolescentes de Tambogrande depende de la decisión que tomemos hoy.</p>
			</section>

			{
				hayContacto && (
					<section id="contacto" class="contacto">
						<h2>Contáctanos</h2>
						<p class="bajada">¿Quieres saber más sobre COLAB Cultural? Escríbenos.</p>
						<div class="canales">
							{contacto.whatsapp && (
								<a
									class="boton whatsapp"
									href={`https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent(saludo)}`}
									target="_blank"
									rel="noopener"
								>
									Escribir por WhatsApp
								</a>
							)}
							{contacto.correo && (
								<a class="boton correo" href={`mailto:${contacto.correo}`}>
									{contacto.correo}
								</a>
							)}
						</div>
					</section>
				)
			}
		</main>

		<footer>
			<Image src={isotipo} alt="" width={36} height={36} />
			<p>COLAB Cultural · El arte y la cultura transforman. La comunidad nos une.</p>
		</footer>
		<script>
			document.documentElement.classList.add('js');
			const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

			// Entrada suave de los bloques; los hermanos entran uno tras otro
			if (!quieto) {
				const alEntrar = new IntersectionObserver(
					(entradas) => {
						for (const entrada of entradas) {
							if (!entrada.isIntersecting) continue;
							alEntrar.unobserve(entrada.target);
							entrada.target.classList.add('visto');
						}
					},
					{ threshold: 0.12 },
				);
				const bloques =
					'.hero > *, #impacto h2, #impacto blockquote, .metas li, #proceso > *, #innovacion .contenedor > :not(.opciones), .opciones article, #aliados > *, #sostenibilidad h2, .tarjetas article, .nota, .cierre p, #contacto > *';
				document.querySelectorAll(bloques).forEach((el) => {
					const orden = [...el.parentElement.children].filter((h) => h.matches(bloques)).indexOf(el);
					el.style.setProperty('--orden', Math.min(orden, 4));
					el.classList.add('aparece');
					alEntrar.observe(el);
				});
			}

			// La barra marca la sección actual y cuánto se ha recorrido
			const enlaces = document.querySelectorAll('.barra nav a');
			const alLeer = new IntersectionObserver(
				(entradas) => {
					for (const entrada of entradas) {
						if (!entrada.isIntersecting) continue;
						enlaces.forEach((a) => {
							if (a.hash === '#' + entrada.target.id) a.setAttribute('aria-current', 'true');
							else a.removeAttribute('aria-current');
						});
					}
				},
				{ rootMargin: '-40% 0px -55% 0px' },
			);
			document.querySelectorAll('main section[id]').forEach((seccion) => alLeer.observe(seccion));

			const avance = document.querySelector('.avance');
			const escena = document.querySelector('.escena');
			const medir = () => {
				const total = document.documentElement.scrollHeight - innerHeight;
				avance.style.setProperty('--avance', total > 0 ? Math.min(scrollY / total, 1) : 0);
				if (quieto) return;
				// El isotipo termina de pintarse un poco antes de que el inicio se suelte
				const caja = escena.getBoundingClientRect();
				const recorrido = (caja.height - innerHeight) * 0.85;
				escena.style.setProperty('--p', recorrido > 0 ? Math.min(Math.max(-caja.top / recorrido, 0), 1) : 1);
			};
			addEventListener('scroll', medir, { passive: true });
			addEventListener('resize', medir);
			medir();

			// La historia de Mateo avanza con el paso que cruza el centro de la pantalla
			const historia = document.querySelector('.historia');
			const alCentro = new IntersectionObserver(
				(entradas) => {
					for (const entrada of entradas) {
						if (entrada.isIntersecting) historia.dataset.paso = entrada.target.dataset.paso;
					}
				},
				// En celular el aula queda fija arriba, así que la línea de cambio baja
				{ rootMargin: matchMedia('(max-width: 760px)').matches ? '-65% 0px -35% 0px' : '-45% 0px -45% 0px' },
			);
			document.querySelectorAll('.paso').forEach((paso) => alCentro.observe(paso));

			const opciones = document.querySelectorAll('[data-eleccion]:is(button)');
			opciones.forEach((boton) => {
				boton.addEventListener('click', () => {
					const eleccion = boton.dataset.eleccion;
					historia.dataset.eleccion = eleccion;
					opciones.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));
					document
						.querySelectorAll('[data-resultado]')
						.forEach((p) => (p.hidden = p.dataset.resultado !== eleccion));
				});
			});

			// Las cifras cuentan desde cero la primera vez que se ven
			function contar(el) {
				const meta = Number(el.dataset.contar);
				const decimales = Number(el.dataset.decimales ?? 0);
				const inicio = performance.now();
				const cuadro = (ahora) => {
					const t = Math.min((ahora - inicio) / 1400, 1);
					el.textContent = (meta * (1 - (1 - t) ** 3)).toFixed(decimales);
					if (t < 1) requestAnimationFrame(cuadro);
				};
				requestAnimationFrame(cuadro);
			}
			const alVer = new IntersectionObserver(
				(entradas) => {
					for (const entrada of entradas) {
						if (!entrada.isIntersecting) continue;
						alVer.unobserve(entrada.target);
						entrada.target.classList.add('visto');
						if (entrada.target.dataset.contar && !quieto) contar(entrada.target);
					}
				},
				{ threshold: 0.6 },
			);
			document.querySelectorAll('[data-contar], .medidor').forEach((el) => alVer.observe(el));

			// Etapas del proceso: pestañas con flechas del teclado
			const proceso = document.querySelector('.proceso');
			const etapas = [...proceso.querySelectorAll('[role="tab"]')];
			function irAEtapa(i, enfocar = false) {
				proceso.style.setProperty('--activa', i);
				etapas.forEach((tab, n) => {
					tab.setAttribute('aria-selected', String(n === i));
					tab.tabIndex = n === i ? 0 : -1;
					document.getElementById(tab.getAttribute('aria-controls')).hidden = n !== i;
				});
				if (enfocar) etapas[i].focus();
			}
			etapas.forEach((tab, i) => {
				tab.addEventListener('click', () => irAEtapa(i));
				tab.addEventListener('keydown', (e) => {
					const paso = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
					if (paso) irAEtapa((i + paso + etapas.length) % etapas.length, true);
				});
			});
			proceso.querySelectorAll('[data-ir]').forEach((boton) => {
				boton.addEventListener('click', () => irAEtapa(Number(boton.dataset.ir), true));
			});

			// Mapa de aliados
			const nodos = document.querySelectorAll('.nodo');
			nodos.forEach((nodo) => {
				nodo.addEventListener('click', () => {
					const i = nodo.dataset.aliado;
					nodos.forEach((n) => n.setAttribute('aria-pressed', String(n === nodo)));
					document.querySelectorAll('[data-linea]').forEach((l) => l.classList.toggle('activa', l.dataset.linea === i));
					document.querySelectorAll('[data-ficha]').forEach((f) => (f.hidden = f.dataset.ficha !== i));
				});
			});

			// Vista previa del mural sin celular
			const mural = document.querySelector('.mural-boton');
			mural.addEventListener('click', () => {
				mural.setAttribute('aria-pressed', String(mural.classList.toggle('activo')));
			});
		</script>
	</body>
