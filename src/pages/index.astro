	/* El ícono acompaña la lectura de su etapa */
	.numero {
		position: sticky;
		top: 96px;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		border: 4px solid var(--color);
		background: var(--color);
		color: #fff;
		box-shadow: 0 0 0 8px color-mix(in srgb, var(--color) 18%, transparent);
		transition:
			background 0.4s,
			border-color 0.4s,
			color 0.4s,
			scale 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
			box-shadow 0.4s;
	}
	.numero svg,
	.labs svg {
		width: 28px;
		height: 28px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.js .etapa:not(.llego) .numero {
		border-color: var(--lila);
		background: #fff;
		color: var(--color);
		box-shadow: none;
		scale: 0.8;
	}
	.js .panel {
		transition:
			opacity 0.6s,
			translate 0.6s;
	}
	.js .etapa:not(.llego) .panel {
		opacity: 0;
		translate: 40px 0;
	}
	.panel {
		position: relative;
		overflow: hidden;
		padding: 36px;
		border-radius: 24px;
		border-left: 8px solid var(--color);
		background: color-mix(in srgb, var(--color) 9%, #fff);
	}
	.panel > * {
		position: relative;
	}
	/* Número grande de fondo */
	.panel .cifra {
		position: absolute;
		right: 24px;
		top: -0.16em;
		font-family: 'Bree Serif', Georgia, serif;
		font-size: clamp(7rem, 20vw, 13rem);
		line-height: 1;
		color: var(--color);
		opacity: 0.13;
		pointer-events: none;
	}
	.panel .etiqueta {
		color: var(--color);
		filter: brightness(0.8);
	}
	.panel h3 {
		font-size: clamp(1.8rem, 4vw, 2.4rem);
	}
	.resumen {
		max-width: 44ch;
		font-size: 1.15rem;
	}
	.claves {
		list-style: none;
		padding: 0;
		margin: 20px 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.claves li {
		padding: 8px 18px;
		border-radius: 999px;
		border: 2px solid var(--color);
		background: #fff;
		font-weight: 800;
	}
	.labs {
		list-style: none;
		padding: 0;
		margin: 24px 0 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
	}
	.labs li {
		--tono: var(--naranja);
		padding: 20px;
		border-radius: 16px;
		border-top: 6px solid var(--tono);
		background: #fff;
		box-shadow: 0 6px 20px rgb(11 21 48 / 0.06);
		transition:
			translate 0.25s,
			box-shadow 0.25s;
	}
	.labs li:hover {
		translate: 0 -6px;
		box-shadow: 0 14px 28px rgb(11 21 48 / 0.12);
	}
	.labs li:nth-child(2) {
		--tono: var(--verde);
	}
	.labs li:nth-child(3) {
		--tono: var(--azul);
	}
	.labs svg {
		box-sizing: content-box;
		padding: 10px;
		border-radius: 12px;
		background: color-mix(in srgb, var(--tono) 14%, #fff);
		color: var(--tono);
	}
	.labs strong {
		display: block;
		margin-top: 8px;
		font-family: 'Bree Serif', Georgia, serif;
		font-weight: 400;
		font-size: 1.25rem;
	}
	/* Al llegar a cada etapa su contenido entra en cascada */
	@media (prefers-reduced-motion: no-preference) {
		.etapa.llego .panel > :not(.cifra),
		.etapa.llego .panel :is(.labs, .claves) li {
			animation: surgir 0.5s ease-out backwards;
			animation-delay: calc(var(--turno, 0) * 80ms);
		}
		.panel > :nth-child(3),
		.panel li:nth-child(1) {
			--turno: 1;
		}
		.panel > :nth-child(4),
		.panel li:nth-child(2) {
			--turno: 2;
		}
		.panel > :nth-child(5),
		.panel li:nth-child(3) {
			--turno: 3;
		}
		.panel > :nth-child(n + 6) {
			--turno: 4;
		}
		.etapa.llego .panel .cifra {
			animation: asomar 0.7s ease-out both;
		}
	}
	@keyframes asomar {
		from {
			opacity: 0;
			translate: 40px 0;
		}
	}

	.innovacion {
