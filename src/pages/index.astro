	.mural-boton {
		position: relative;
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		border-radius: 12px;
		overflow: hidden;
		background: none;
		font: inherit;
		cursor: pointer;
	}
	.mural-boton img {
		display: block;
		width: 100%;
	}
	.mural-pista {
		margin: 12px 0 0;
		font-size: 0.9rem;
		opacity: 0.75;
	}
	/* Las posiciones salen de las coordenadas del mural (1200 × 900) */
	.capa-ar {
		position: absolute;
		inset: 0;
		container-type: inline-size;
	}
	.capa-ar > * {
		position: absolute;
		translate: -50% -50%;
		opacity: 0;
		transition: opacity 0.4s 0.9s;
	}
	.mural-boton.activo .capa-ar > * {
		opacity: 1;
	}
	.capa-ar .escaner {
		left: 50%;
		top: 0;
		width: 100%;
		height: 6px;
		background: #fff;
		box-shadow: 0 0 18px 6px rgb(255 255 255 / 0.7);
		transition: none;
	}
	.mural-boton.activo .escaner {
		animation: escanear 0.9s ease-in-out forwards;
	}
	@keyframes escanear {
		from {
			top: 0;
			opacity: 1;
		}
		99% {
			opacity: 1;
		}
		to {
			top: 100%;
			opacity: 0;
		}
	}
	.sol-aro,
	.sol,
	.pelota,
	.mango {
		aspect-ratio: 1;
		border-radius: 50%;
	}
	.sol-aro {
		left: 77.5%;
		top: 21.1%;
		width: 19%;
		border: 5px solid #ffc21a;
		animation: latir 1.1s ease-in-out infinite alternate;
	}
	.sol {
		left: 77.5%;
		top: 21.1%;
		width: 11%;
		background: var(--naranja);
		animation: latir 1.1s ease-in-out infinite alternate-reverse;
	}
	.pelota {
		left: 35%;
		top: 89.4%;
		width: 8.6%;
		background: #fff;
		border: 3px solid var(--marino);
		animation: rebotar 0.52s ease-out infinite alternate;
	}
	.mango {
		width: 3.4%;
		background: var(--naranja);
		border: 2px solid var(--marino);
		animation: latir 0.7s ease-in-out infinite alternate;
	}
	.capa-ar .cartel {
		left: 50%;
		top: 9%;
		padding: 0.4em 1em;
		border: 3px solid #fff;
		border-radius: 999px;
		background: var(--morado);
		color: #fff;
		font-size: clamp(0.7rem, 3.4cqw, 1.2rem);
		white-space: nowrap;
		animation: flotar-cartel 1.5s ease-in-out infinite alternate;
	}
	@keyframes latir {
		to {
			scale: 1.5;
		}
	}
	@keyframes rebotar {
		to {
			translate: -50% -330%;
		}
	}
	@keyframes flotar-cartel {
		to {
			translate: -50% -30%;
		}
	}
	.prueba .boton {
		margin-top: 0;
