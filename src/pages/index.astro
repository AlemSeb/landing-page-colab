	:is(.nodo, .ficha article)[data-tipo='Colectivo cultural'] {
		--tono: var(--verde);
	}
	.nodo {
		position: absolute;
		display: grid;
		place-items: center;
		width: 22%;
		aspect-ratio: 1;
		translate: -50% -50%;
		padding: 2px;
		border: 3px solid var(--tono);
		border-radius: 50%;
		background: color-mix(in srgb, var(--tono) 12%, #fff);
