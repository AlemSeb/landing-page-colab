	.proceso {
		position: relative;
		list-style: none;
		margin: 32px 0 0;
		padding: 0;
		display: grid;
		gap: 40px;
	}
	/* El riel une las etapas y se llena de color con el scroll */
	.proceso::before,
	.proceso::after {
		content: '';
		position: absolute;
		left: 29px;
		top: 32px;
		bottom: 32px;
		width: 6px;
		border-radius: 3px;
	}
	.proceso::before {
		background: var(--lila);
	}
	.proceso::after {
		background: linear-gradient(180deg, var(--naranja), var(--magenta), var(--verde));
		clip-path: inset(0 0 calc(100% - var(--r, 1) * 100%) 0 round 3px);
	}
	.etapa {
		display: grid;
		grid-template-columns: 64px minmax(0, 1fr);
		align-items: start;
		gap: 24px;
